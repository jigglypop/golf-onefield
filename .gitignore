# 빌드 산출물
flightbench/target/
__pycache__/
*.pyc

# 재생성 가능한 펼친 장 (python -B run_higgs.py 로 다시 만든다)
unfolded_field.npz
fewshot.out
fewshot_reg.out

# 웹 산출물 (field4 --dump 와 build_bench.py 로 다시 만든다)
web/*.bin
web/field_meta.json
web/onefield_bench.html

# 영상 파이프라인 산출물
*_t.csv
*_track.mp4
data/real/**/*.mp4
data/real/**/*.mov

# 외부 공개 실측 자료 (라이선스 미표기 → 내려받아 쓰고 커밋하지 않는다: tools/fetch_trackman_public.sh)
data/real/external/

# 비밀 값 (API 키 등). 저장소 어디에 있든 커밋하지 않는다
.env
.env.*
!.env.example
